{
  "id": "mpAppPage000013",
  "name": "13 App: the HTML page (served by a webhook)",
  "nodes": [
    {
      "parameters": {
        "content": "## The web page\n`GET /webhook/app` returns an HTML page. Its buttons call the other webhooks on this instance: /docs/search, /docs/file, /ticket-triage, and the chat trigger.\n\nThe HTML lives in the Respond node as a plain string (not an expression), so n8n serves it as-is with `Content-Type: text/html`.",
        "width": 560,
        "height": 160
      },
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "app",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook: GET /app",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "8ab7e585-8fa4-5bdb-8e0e-1c0b55922282"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Workflow console</title>\n<style>\n  :root { --ink:#1a1a1a; --muted:#666; --line:#e3e3e3; --bg:#f6f6f4; --card:#fff; --accent:#ff6d1f; --ok:#1a7f37; --bad:#b42318; }\n  * { box-sizing:border-box; }\n  body { margin:0; font:15px/1.45 -apple-system, \"Segoe UI\", Inter, Arial, sans-serif; color:var(--ink); background:var(--bg); }\n  header { padding:18px 28px; background:#111; color:#fff; display:flex; align-items:baseline; gap:18px; }\n  header h1 { margin:0; font-size:18px; font-weight:600; }\n  header span { color:#aaa; font-size:13px; }\n  nav { display:flex; gap:4px; padding:12px 28px 0; }\n  nav button { border:1px solid var(--line); border-bottom:none; background:#eee; padding:10px 16px; border-radius:8px 8px 0 0; cursor:pointer; font:inherit; }\n  nav button.on { background:var(--card); font-weight:600; }\n  main { padding:20px 28px 40px; }\n  section { display:none; } section.on { display:block; }\n  .row { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }\n  input[type=text], textarea { flex:1; min-width:280px; font:inherit; padding:10px 12px; border:1px solid #bbb; border-radius:8px; background:#fff; }\n  textarea { min-height:90px; width:100%; }\n  button.go { font:inherit; padding:10px 18px; border:none; border-radius:8px; background:var(--accent); color:#fff; cursor:pointer; font-weight:600; }\n  button.go[disabled] { opacity:.5; }\n  label.mode { font-size:14px; color:var(--muted); }\n  .split { display:grid; grid-template-columns: 1fr 1fr; gap:18px; margin-top:16px; }\n  @media (max-width:900px){ .split { grid-template-columns:1fr; } }\n  .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:10px; }\n  .card h3 { margin:0 0 4px; font-size:15px; }\n  .card .meta { color:var(--muted); font-size:13px; }\n  .card p { margin:8px 0 0; }\n  mark { background:#fff2a8; padding:0 2px; }\n  iframe { width:100%; height:78vh; border:1px solid var(--line); border-radius:10px; background:#fff; }\n  .hint { color:var(--muted); font-size:13px; margin:6px 0 0; }\n  .kv { display:grid; grid-template-columns: 150px 1fr; gap:6px 12px; font-size:14px; }\n  .kv b { color:var(--muted); font-weight:500; }\n  .pill { display:inline-block; padding:2px 9px; border-radius:99px; font-size:12px; background:#eee; margin-right:6px; }\n  .pill.urgent, .pill.high, .pill.angry { background:#fde2e1; color:var(--bad); }\n  .pill.low, .pill.neutral, .pill.happy { background:#e3f5e8; color:var(--ok); }\n  pre { background:#111; color:#ddd; padding:12px; border-radius:8px; overflow:auto; font-size:12.5px; }\n  .status { font-size:13px; color:var(--muted); min-height:18px; margin-top:6px; }\n  .err { color:var(--bad); }\n</style>\n</head>\n<body>\n<header><h1>Workflow console</h1><span>every button on this page is an n8n webhook</span></header>\n<nav>\n  <button class=\"on\" data-tab=\"search\">Search the PDFs</button>\n  <button data-tab=\"triage\">Triage a ticket</button>\n  <button data-tab=\"ask\">Ask which workflow</button>\n  <button data-tab=\"how\">How this page works</button>\n</nav>\n<main>\n\n<section id=\"search\" class=\"on\">\n  <div class=\"row\">\n    <input type=\"text\" id=\"q\" placeholder='try: sticky sessions   or   \"queue mode\"   or   webhook -cron' autofocus>\n    <label class=\"mode\"><input type=\"radio\" name=\"mode\" value=\"keyword\" checked> keyword, ranked</label>\n    <label class=\"mode\"><input type=\"radio\" name=\"mode\" value=\"exact\"> exact phrase</label>\n    <button class=\"go\" id=\"goSearch\">Search</button>\n  </div>\n  <p class=\"hint\">Deterministic: Postgres full-text search over every page of every PDF in the folder. Same query, same results, no model involved. Quotes force a phrase, a leading minus excludes a word.</p>\n  <div class=\"status\" id=\"sStatus\"></div>\n  <div class=\"split\">\n    <div id=\"results\"></div>\n    <div><iframe id=\"pdf\" title=\"PDF\"></iframe><p class=\"hint\" id=\"pdfName\">Click a result to open the whole PDF here.</p></div>\n  </div>\n</section>\n\n<section id=\"triage\">\n  <textarea id=\"ticket\">I was charged twice this month and your app keeps logging me out. Fix this or I am cancelling.</textarea>\n  <div class=\"row\" style=\"margin-top:8px\"><button class=\"go\" id=\"goTriage\">Triage with Claude</button><span class=\"hint\">POST /webhook/ticket-triage, structured output through a JSON schema</span></div>\n  <div class=\"status\" id=\"tStatus\"></div>\n  <div id=\"triageOut\"></div>\n</section>\n\n<section id=\"ask\">\n  <div class=\"row\"><input type=\"text\" id=\"askQ\" placeholder=\"what happens when a customer calls and nobody answers?\"><button class=\"go\" id=\"goAsk\">Ask</button></div>\n  <p class=\"hint\">Chat trigger → sub-workflow → cosine search in pgvector → answer logged to Postgres.</p>\n  <div class=\"status\" id=\"aStatus\"></div>\n  <div id=\"askOut\"></div>\n</section>\n\n<section id=\"how\">\n  <div class=\"card\">\n    <h3>This page is served by n8n</h3>\n    <p>A Webhook node answers <code>GET /webhook/app</code> with this HTML. There is no separate web server.</p>\n  </div>\n  <div class=\"card\">\n    <h3>Search</h3>\n    <p>The page POSTs <code>{ q, mode }</code> to <code>/webhook/docs/search</code>. That workflow runs one SQL statement against Postgres: keyword mode uses <code>websearch_to_tsquery</code>, <code>ts_rank_cd</code> and <code>ts_headline</code>; exact mode uses <code>ILIKE</code>. The PDFs were indexed by workflow 10 (Read files → Extract from File → chunk → INSERT).</p>\n  </div>\n  <div class=\"card\">\n    <h3>Open PDF</h3>\n    <p><code>GET /webhook/docs/file?name=x.pdf</code> checks the name against the index, reads the file from disk, and responds with the binary and <code>Content-Type: application/pdf</code>, so the browser renders it in the frame.</p>\n  </div>\n  <div class=\"card\">\n    <h3>Triage and Ask</h3>\n    <p>Same webhooks you can call with curl. The page just does the POST for you and renders the JSON.</p>\n  </div>\n</section>\n</main>\n\n<script>\nconst base = location.origin + '/webhook';\nconst $ = (s) => document.querySelector(s);\nconst esc = (s) => String(s ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\n\ndocument.querySelectorAll('nav button').forEach(b => b.onclick = () => {\n  document.querySelectorAll('nav button').forEach(x => x.classList.toggle('on', x === b));\n  document.querySelectorAll('main section').forEach(s => s.classList.toggle('on', s.id === b.dataset.tab));\n});\n\nasync function post(path, body) {\n  const r = await fetch(base + path, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });\n  const text = await r.text();\n  let data; try { data = JSON.parse(text); } catch { data = { raw: text }; }\n  if (!r.ok) throw new Error(`HTTP ${r.status}: ${data.message || data.error || text.slice(0, 200)}`);\n  return data;\n}\n\nfunction highlight(snippet, q) {\n  if (!q) return esc(snippet);\n  const safe = esc(snippet);\n  const re = new RegExp(esc(q).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'), 'gi');\n  return safe.replace(re, m => `<mark>${m}</mark>`);\n}\n\nasync function search() {\n  const q = $('#q').value.trim(); if (!q) return;\n  const mode = document.querySelector('input[name=mode]:checked').value;\n  $('#sStatus').textContent = 'searching…'; $('#results').innerHTML = '';\n  const t0 = performance.now();\n  try {\n    const d = await post('/docs/search', { q, mode });\n    const ms = Math.round(performance.now() - t0);\n    $('#sStatus').textContent = `${d.results.length} hit${d.results.length === 1 ? '' : 's'} in ${d.docs} document${d.docs === 1 ? '' : 's'} · ${mode} · ${ms} ms · ${esc(d.sql)}`;\n    if (!d.results.length) { $('#results').innerHTML = '<div class=\"card\">Nothing matched. Exact mode needs the words in that order; keyword mode needs each word to appear.</div>'; return; }\n    for (const r of d.results) {\n      const card = document.createElement('div'); card.className = 'card';\n      const snippet = mode === 'exact' ? highlight(r.snippet, q) : r.snippet;   // keyword mode is already marked by Postgres\n      card.innerHTML = `<h3>${esc(r.name)}</h3><div class=\"meta\">chunk ${r.chunk_no} of ${r.n_chunks}${r.rank ? ` · rank ${Number(r.rank).toFixed(3)}` : ''}</div><p>${snippet}</p><p><a href=\"#\" data-name=\"${esc(r.name)}\">Open the PDF</a></p>`;\n      card.querySelector('a').onclick = (e) => { e.preventDefault(); openPdf(r.name); };\n      $('#results').appendChild(card);\n    }\n  } catch (e) { $('#sStatus').innerHTML = `<span class=\"err\">${esc(e.message)}</span>`; }\n}\nfunction openPdf(name) {\n  $('#pdf').src = `${base}/docs/file?name=${encodeURIComponent(name)}`;\n  $('#pdfName').textContent = name;\n}\n$('#goSearch').onclick = search;\n$('#q').addEventListener('keydown', e => { if (e.key === 'Enter') search(); });\n\n$('#goTriage').onclick = async () => {\n  const ticket = $('#ticket').value.trim(); if (!ticket) return;\n  $('#tStatus').textContent = 'asking Claude…'; $('#triageOut').innerHTML = ''; $('#goTriage').disabled = true;\n  try {\n    const d = await post('/ticket-triage', { ticket });\n    const t = d.triage;\n    $('#tStatus').textContent = `${d.model} · ${d.usage.input_tokens} tokens in, ${d.usage.output_tokens} out`;\n    $('#triageOut').innerHTML = `<div class=\"card\">\n      <div><span class=\"pill\">${esc(t.category)}</span><span class=\"pill ${esc(t.priority)}\">${esc(t.priority)}</span><span class=\"pill ${esc(t.sentiment)}\">${esc(t.sentiment)}</span>${t.requires_human ? '<span class=\"pill urgent\">needs a human</span>' : ''}</div>\n      <div class=\"kv\" style=\"margin-top:10px\"><b>summary</b><span>${esc(t.summary)}</span><b>key issues</b><span>${(t.key_issues || []).map(esc).join('<br>')}</span><b>suggested reply</b><span>${esc(t.suggested_reply)}</span></div>\n      <details style=\"margin-top:10px\"><summary class=\"hint\">raw JSON</summary><pre>${esc(JSON.stringify(d, null, 2))}</pre></details></div>`;\n  } catch (e) { $('#tStatus').innerHTML = `<span class=\"err\">${esc(e.message)}</span>`; }\n  $('#goTriage').disabled = false;\n};\n\n$('#goAsk').onclick = async () => {\n  const q = $('#askQ').value.trim(); if (!q) return;\n  $('#aStatus').textContent = 'asking…'; $('#askOut').innerHTML = '';\n  try {\n    const d = await post('/b2ed8158-3467-5af8-8516-582619fc16a2/chat', { sessionId: 'console-' + Date.now(), action: 'sendMessage', chatInput: q });\n    $('#aStatus').textContent = '';\n    $('#askOut').innerHTML = `<div class=\"card\"><pre style=\"background:#fff;color:#1a1a1a;white-space:pre-wrap;padding:0\">${esc(d.output || JSON.stringify(d))}</pre></div>`;\n  } catch (e) { $('#aStatus').innerHTML = `<span class=\"err\">${esc(e.message)}</span>`; }\n};\n$('#askQ').addEventListener('keydown', e => { if (e.key === 'Enter') $('#goAsk').onclick(); });\n</script>\n</body>\n</html>\n",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
