{
  "id": "mpDocsFile00012",
  "name": "12 Docs: serve a PDF from the folder",
  "nodes": [
    {
      "parameters": {
        "content": "## Serve a PDF\n`GET /docs/file?name=how-this-works.pdf`\n\nThe name must be a plain file name (no slashes) and must exist in the index. Then the file is read from the docs folder and returned as `application/pdf`, inline, so the browser shows the whole document.",
        "width": 560,
        "height": 150
      },
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "docs/file",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook: GET /docs/file",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "cf7c08d6-ca76-5137-9c97-2b9940345dda"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "docsDir",
              "name": "docsDir",
              "value": "/data/pdfs",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst name = String($input.first().json.query?.name || '');\nconst ok = /^[A-Za-z0-9._ -]+\\.pdf$/.test(name) && !name.includes('..');\nreturn [{ json: { name, ok, path: $('Config').first().json.docsDir + '/' + name } }];\n"
      },
      "name": "Check the name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS n FROM docs WHERE name = $1;",
        "options": {
          "queryReplacement": "={{ [$json.name] }}"
        }
      },
      "name": "Is it in the index?",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        300
      ],
      "credentials": {
