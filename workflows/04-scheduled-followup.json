              "type": "string"
            },
            {
              "id": "vapiAssistantId",
              "name": "vapiAssistantId",
              "value": "asst_speed_to_lead",
              "type": "string"
            },
            {
              "id": "vapiAssistantIdFollowup",
              "name": "vapiAssistantIdFollowup",
              "value": "asst_follow_up",
              "type": "string"
            },
            {
              "id": "vapiPhoneNumberId",
              "name": "vapiPhoneNumberId",
              "value": "pn_xxx",
              "type": "string"
            },
            {
              "id": "ghlLocationId",
              "name": "ghlLocationId",
              "value": "loc_xxx",
              "type": "string"
            },
            {
              "id": "twilioAccountSid",
              "name": "twilioAccountSid",
              "value": "ACxxxxxxxx",
              "type": "string"
            },
            {
              "id": "businessName",
              "name": "businessName",
              "value": "Reflections Mobile Detailing",
              "type": "string"
            },
            {
              "id": "ownerEmail",
              "name": "ownerEmail",
              "value": "owner@example.com",
              "type": "string"
            },
            {
              "id": "oncallEmail",
              "name": "oncallEmail",
              "value": "maria@example.com",
              "type": "string"
            },
            {
              "id": "alertFrom",
              "name": "alertFrom",
              "value": "alerts@example.com",
              "type": "string"
            },
            {
              "id": "slackWebhookUrl",
              "name": "slackWebhookUrl",
              "value": "",
              "type": "string"
            },
            {
              "id": "followupMaxAttempts",
              "name": "followupMaxAttempts",
              "value": 4,
              "type": "number"
            },
            {
              "id": "followupWindowDays",
              "name": "followupWindowDays",
              "value": 6,
              "type": "number"
            },
            {
              "id": "paceSeconds",
              "name": "paceSeconds",
              "value": 20,
              "type": "number"
            },
            {
              "id": "n8nBase",
              "name": "n8nBase",
              "value": "http://localhost:5678",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.ghlBase }}/contacts/",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1500
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "locationId",
              "value": "={{ $('Config').item.json.ghlLocationId }}"
            },
            {
              "name": "query",
              "value": "ai-no-answer"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        }
      },
      "name": "Find contacts tagged ai-no-answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "GoHighLevel API token",
          "id": "mpCredGhl0000002"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "contacts",
        "options": {}
      },
      "name": "Split contacts",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst MAX_ATTEMPTS = Number(cfg.followupMaxAttempts || 4);\nconst WINDOW_DAYS  = Number(cfg.followupWindowDays  || 6);\nconst CLOSED = ['ai-booked', 'ai-do-not-call', 'ai-bought-elsewhere', 'ai-not-interested'];\nconst out = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  const tags = (c.tags || []).map(t => String(t).toLowerCase());\n  let attempt = 1;\n  for (const t of tags) { const m = /^ai-attempt-(\\d+)$/.exec(t); if (m) attempt = Math.max(attempt, Number(m[1])); }\n  const ageDays = c.dateAdded ? (Date.now() - new Date(c.dateAdded)) / 86400000 : 0;\n  let skip = null;\n  if (tags.some(t => CLOSED.includes(t))) skip = 'closed';\n  else if (attempt >= MAX_ATTEMPTS)        skip = 'max_attempts';\n  else if (ageDays > WINDOW_DAYS)          skip = 'outside_window';\n  else if (!c.phone)                       skip = 'no_phone';\n  out.push({ json: { contactId: c.id, name: c.firstName || c.contactName || 'there', phone: c.phone,\n                     attempt, nextAttempt: attempt + 1, skip } });\n}\nreturn out;\n"
      },
      "name": "Decide: call again, or stop?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Eligible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "amount": "={{ $('Config').item.json.paceSeconds }}",
        "unit": "seconds"
      },
      "name": "Pace the calls",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        200
      ],
      "webhookId": "e508aac9-07cc-5493-9bdf-833f0f73b6be"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.vapiBase }}/call",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1500
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  assistantId: $('Config').item.json.vapiAssistantIdFollowup,\n  phoneNumberId: $('Config').item.json.vapiPhoneNumberId,\n  customer: { number: $json.phone, name: $json.name },\n  assistantOverrides: { variableValues: { name: $json.name, attempt: $json.nextAttempt } },\n  metadata: { contactId: $json.contactId }\n}) }}"
      },
      "name": "Follow-up call (Vapi)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Vapi API key",
          "id": "mpCredVapi000001"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.ghlBase }}/contacts/{{ $('Eligible?').item.json.contactId }}/tags",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1500
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tags: ['ai-attempt-' + $('Eligible?').item.json.nextAttempt] }) }}"
      },
      "name": "Tag ai-attempt-N",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "GoHighLevel API token",
          "id": "mpCredGhl0000002"
        }
      }
    },
    {
      "parameters": {
        "numberInputs": 2
      },
      "name": "Merge called + skipped",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst called = $('Eligible?').all(0).map(i => i.json);\nconst skipped = $('Eligible?').all(1).map(i => i.json);\nconst text = [\n  'Called:', ...(called.map(c => `  ${c.name} ${c.phone} (attempt ${c.nextAttempt})`)), called.length ? '' : '  none', '',\n  'Skipped:', ...(skipped.map(c => `  ${c.name} (${c.skip})`)), skipped.length ? '' : '  none',\n].join('\\n');\nreturn [{ json: { subject: `Follow-up pass: ${called.length} called, ${skipped.length} skipped`, text } }];\n"
      },
      "name": "Summarize the pass",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').item.json.alertFrom }}",
        "toEmail": "={{ $('Config').item.json.ownerEmail }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "name": "Daily summary email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2420,
        300
      ],
      "credentials": {
        "smtp": {
          "name": "SMTP (Resend)",
          "id": "mpCredSmtp000004"
        }
      }
    }
  ],
