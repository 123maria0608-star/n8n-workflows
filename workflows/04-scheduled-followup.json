{
  "name": "04 Scheduled follow-up: weekday cron with tag-based state",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1-5"
            }
          ]
        }
      },
      "name": "Weekdays 10:00 shop time",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://services.leadconnectorhq.com/contacts/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "locationId",
              "value": "={{ $env.GHL_LOCATION_ID }}"
            },
            {
              "name": "query",
              "value": "ai-no-answer"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "name": "Find contacts tagged ai-no-answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "GoHighLevel API token"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "contacts",
        "options": {}
      },
      "name": "Split contacts",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// State lives in the CRM's tags, so what the owner sees in the CRM and what\n// this job believes can never drift apart.\n//   ai-booked / ai-do-not-call / ai-bought-elsewhere / ai-not-interested \u2192 done\n//   ai-attempt-N \u2192 how many calls have gone out\nconst MAX_ATTEMPTS = Number($env.FOLLOWUP_MAX_ATTEMPTS || 4);\nconst WINDOW_DAYS  = Number($env.FOLLOWUP_WINDOW_DAYS  || 6);\nconst CLOSED = ['ai-booked','ai-do-not-call','ai-bought-elsewhere','ai-not-interested'];\nconst out = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  const tags = (c.tags || []).map(t => String(t).toLowerCase());\n  let attempt = 1;\n  for (const t of tags) { const m = /^ai-attempt-(\\d+)$/.exec(t); if (m) attempt = Math.max(attempt, Number(m[1])); }\n  const ageDays = c.dateAdded ? (Date.now() - new Date(c.dateAdded)) / 86400000 : 0;\n  let skip = null;\n  if (tags.some(t => CLOSED.includes(t))) skip = 'closed';\n  else if (attempt >= MAX_ATTEMPTS)        skip = 'max_attempts';\n  else if (ageDays > WINDOW_DAYS)          skip = 'outside_window';\n  else if (!c.phone)                       skip = 'no_phone';\n  out.push({ json: { contactId: c.id, name: c.firstName || c.contactName || 'there', phone: c.phone,\n                     attempt, nextAttempt: attempt + 1, skip } });\n}\nreturn out;\n"
      },
      "name": "Decide: call again, or stop?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Eligible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "name": "Pace: 1 call / 20s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vapi.ai/call",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  assistantId: $env.VAPI_ASSISTANT_ID_FOLLOWUP,\n  phoneNumberId: $env.VAPI_PHONE_NUMBER_ID,\n  customer: { number: $json.phone, name: $json.name },\n  assistantOverrides: { variableValues: { name: $json.name, attempt: $json.nextAttempt } },\n  metadata: { contactId: $json.contactId }\n}) }}",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "name": "Follow-up call (Vapi)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Vapi API key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $('Eligible?').item.json.contactId }}/tags",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tags: ['ai-attempt-' + $('Eligible?').item.json.nextAttempt] }) }}",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1500
          }
        }
      },
      "name": "Tag ai-attempt-N",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "GoHighLevel API token"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.ALERT_FROM }}",
        "toEmail": "={{ $env.OWNER_EMAIL }}",
        "subject": "=Follow-up pass: {{ $('Eligible?').all(0).length }} called, {{ $('Eligible?').all(1).length }} skipped",
        "emailFormat": "text",
        "text": "=Called:\n{{ $('Eligible?').all(0).map(i => i.json.name + ' ' + i.json.phone + ' (attempt ' + i.json.nextAttempt + ')').join('\\n') || '\u2014' }}\n\nSkipped:\n{{ $('Eligible?').all(1).map(i => i.json.name + ' \u2014 ' + i.json.skip).join('\\n') || '\u2014' }}",
        "options": {}
      },
      "name": "Daily summary email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1760,
        300
      ],
      "credentials": {
        "smtp": {
          "name": "SMTP (Resend)"
        }
      },
      "executeOnce": true
    }
  ],
  "connections": {
    "Weekdays 10:00 shop time": {
      "main": [
        [
          {
            "node": "Find contacts tagged ai-no-answer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find contacts tagged ai-no-answer": {
      "main": [
        [
          {
            "node": "Split contacts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split contacts": {
      "main": [
        [
          {
            "node": "Decide: call again, or stop?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decide: call again, or stop?": {
      "main": [
        [
          {
            "node": "Eligible?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Eligible?": {
      "main": [
        [
          {
            "node": "Pace: 1 call / 20s",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Daily summary email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pace: 1 call / 20s": {
      "main": [
        [
          {
            "node": "Follow-up call (Vapi)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Follow-up call (Vapi)": {
      "main": [
        [
          {
            "node": "Tag ai-attempt-N",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tag ai-attempt-N": {
      "main": [
        [
          {
            "node": "Daily summary email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "error-alerting",
    "timezone": "America/Los_Angeles"
  },
  "tags": [
    {
      "name": "cron"
    },
    {
      "name": "follow-up"
    },
    {
      "name": "gohighlevel"
    }
  ]
}