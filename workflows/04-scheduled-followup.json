{
  "id": "mpFollowupCron04",
  "name": "04 Scheduled follow-up: weekday cron with tag-based state",
  "nodes": [
    {
      "parameters": {
        "content": "## Scheduled follow-up\nRuns weekdays at 10:00 shop time. Pulls contacts the AI could not reach, decides per contact whether to try again, paces the calls, and tags each attempt.\n\nState lives in CRM tags (ai-attempt-N, ai-booked, ai-do-not-call...), so what the owner sees in the CRM and what this job believes can never drift apart.",
        "width": 560,
        "height": 190
      },
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1-5"
            }
          ]
        }
      },
      "name": "Weekdays 10:00 shop time",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {},
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        480
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "vapiBase",
              "name": "vapiBase",
              "value": "https://api.vapi.ai",
              "type": "string"
            },
            {
              "id": "ghlBase",
              "name": "ghlBase",
              "value": "https://services.leadconnectorhq.com",
              "type": "string"
            },
            {
              "id": "twilioBase",
