{
  "id": "mpDocsSearch0011",
  "name": "11 Docs: deterministic search API (Postgres full-text)",
  "nodes": [
    {
      "parameters": {
        "content": "## Deterministic search\nPOST `{ \"q\": \"sticky sessions\", \"mode\": \"keyword\" | \"exact\" }`.\n\nKeyword mode: Postgres full-text search. `websearch_to_tsquery` understands quotes and minus, `ts_rank_cd` orders, `ts_headline` builds the highlighted snippet.\nExact mode: `ILIKE '%phrase%'`, the words in that order, case-insensitive.\n\nNo model, no randomness: the same input always returns the same rows.",
        "width": 600,
        "height": 190
      },
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "docs/search",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook: POST /docs/search",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        340
      ],
      "webhookId": "f4cc102c-601b-50b1-bed6-ec0c3f9aac56"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || {};\nconst q = String(b.q || '').trim().slice(0, 200);\nconst mode = b.mode === 'exact' ? 'exact' : 'keyword';\nif (!q) throw new Error('q is required');\nreturn [{ json: { q, mode } }];\n"
      },
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "m",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "exact",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Exact phrase?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        340
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT name, chunk_no, n_chunks, NULL::real AS rank,\n       substr(content, GREATEST(1, position(lower($1) in lower(content)) - 110), 260) AS snippet\nFROM docs\nWHERE content ILIKE '%' || $1 || '%'\nORDER BY name, chunk_no\nLIMIT 20;",
        "options": {
          "queryReplacement": "={{ [$json.q] }}"
        }
      },
      "name": "Exact: ILIKE",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        240
      ],
      "credentials": {
        "postgres": {
          "name": "Postgres (workflow index)",
          "id": "mpCredPg00000005"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH q AS (SELECT websearch_to_tsquery('english', $1) AS tsq)\nSELECT d.name, d.chunk_no, d.n_chunks,\n       ts_rank_cd(d.tsv, q.tsq) AS rank,\n       ts_headline('english', d.content, q.tsq,\n         'StartSel=<mark>, StopSel=</mark>, MaxFragments=2, MinWords=6, MaxWords=26, FragmentDelimiter= … ') AS snippet\nFROM docs d, q\nWHERE d.tsv @@ q.tsq\nORDER BY rank DESC, d.name, d.chunk_no\nLIMIT 20;",
        "options": {
          "queryReplacement": "={{ [$json.q] }}"
        }
      },
      "name": "Keyword: full-text search",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        440
      ],
      "credentials": {
        "postgres": {
          "name": "Postgres (workflow index)",
          "id": "mpCredPg00000005"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst v = $('Validate').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.name);\nconst docs = new Set(rows.map(r => r.name)).size;\nreturn [{ json: { q: v.q, mode: v.mode, docs, results: rows,\n  sql: v.mode === 'exact' ? \"content ILIKE '%' || $1 || '%'\" : \"tsv @@ websearch_to_tsquery('english', $1) ORDER BY ts_rank_cd\" } }];\n"
      },
      "name": "Shape results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        340
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "name": "Respond JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        340
      ]
    }
  ],
