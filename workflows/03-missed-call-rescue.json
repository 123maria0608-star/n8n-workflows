        "toEmail": "={{ $('Config').item.json.ownerEmail }}",
        "subject": "=Missed call from {{ $('Shape + opt-out + once-a-day').item.json.from }} ({{ $('Shape + opt-out + once-a-day').item.json.status }})",
        "emailFormat": "text",
        "text": "=Missed call at {{ $('Shape + opt-out + once-a-day').item.json.at }}\nFrom: {{ $('Shape + opt-out + once-a-day').item.json.from }}\nRescue text sent: {{ $('Shape + opt-out + once-a-day').item.json.send ? 'yes' : 'no (' + $('Shape + opt-out + once-a-day').item.json.reason + ')' }}\nCall SID: {{ $('Shape + opt-out + once-a-day').item.json.callSid }}",
