          },
          "conditions": [
            {
              "id": "status",
              "leftValue": "={{ ['no-answer','busy','failed'].includes($json.body.DialCallStatus || $json.body.CallStatus) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "inbound",
              "leftValue": "={{ $json.body.Direction }}",
              "rightValue": "inbound",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Missed inbound call?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body;\nconst from = b.From, to = b.To;\nconst store = $getWorkflowStaticData('global');\nstore.optOut = store.optOut || [];\nstore.texted = store.texted || {};\nconst now = Date.now(), DAY = 24 * 60 * 60 * 1000;\nconst already  = store.texted[from] && now - store.texted[from] < DAY;\nconst optedOut = store.optOut.includes(from);\nif (!already && !optedOut) store.texted[from] = now;\nreturn [{ json: {\n  from, to, callSid: b.CallSid, status: b.DialCallStatus || b.CallStatus,\n  send: !already && !optedOut,\n  reason: optedOut ? 'opted_out' : already ? 'already_texted_today' : null,\n  at: new Date().toISOString(),\n}}];\n"
      },
      "name": "Shape + opt-out + once-a-day",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "send",
              "leftValue": "={{ $json.send }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Send rescue text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.twilioBase }}/2010-04-01/Accounts/{{ $('Config').item.json.twilioAccountSid }}/Messages.json",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1500
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "From",
              "value": "={{ $json.to }}"
            },
            {
              "name": "To",
              "value": "={{ $json.from }}"
            },
            {
              "name": "Body",
              "value": "={{ $('Config').item.json.businessName }} here, sorry we missed you. Reply with what you need (service and vehicle or address) and we'll get you a quote or a time. Reply STOP to opt out."
            }
          ]
        }
      },
      "name": "SMS the caller back (Twilio)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
