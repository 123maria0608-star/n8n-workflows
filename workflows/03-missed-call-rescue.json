      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        640
      ],
      "webhookId": "f4040d63-e17e-5ead-8bba-f74aa8d465f1"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body;\nconst body = String(b.Body || '').trim().toLowerCase();\nconst store = $getWorkflowStaticData('global');\nstore.optOut = store.optOut || [];\nlet action = 'none';\nif (/^(stop|stopall|unsubscribe|cancel|end|quit)$/.test(body)) { if (!store.optOut.includes(b.From)) store.optOut.push(b.From); action = 'opt_out'; }\nif (/^(start|unstop|yes)$/.test(body)) { store.optOut = store.optOut.filter(n => n !== b.From); action = 'opt_in'; }\nreturn [{ json: { from: b.From, body: b.Body, action, optOutList: store.optOut } }];\n"
      },
      "name": "Record STOP / START",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        640
      ]
    }
