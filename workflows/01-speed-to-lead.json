    {
      "parameters": {
        "jsCode": "\n// Two callers, one path: a CRM workflow webhook (GoHighLevel shape) and a\n// plain web form. Both end up as the same lead object.\nconst b = $input.first().json.body || {};\nconst c = b.customData || b.custom_data || {};\nconst first = b.first_name || b.firstName || (b.name || '').split(' ')[0] || '';\nconst last  = b.last_name  || b.lastName  || (b.name ? b.name.split(' ').slice(1).join(' ') : '');\nconst raw   = String(b.phone || c.phone || '').replace(/[^\\d+]/g, '');\nconst phone = raw.startsWith('+') ? raw\n            : raw.length === 10 ? '+1' + raw\n            : raw.length === 11 && raw.startsWith('1') ? '+' + raw : '';\nreturn [{ json: {\n  contactId: b.contact_id || b.id || null,\n  name: `${first} ${last}`.trim() || 'there',\n  phone,\n  service: b.service || c.service || '',\n  vehicle: b.vehicle || c.vehicle || '',\n  source:  b.source  || c.source  || (b.customData ? 'ghl' : 'web-form'),\n  receivedAt: new Date().toISOString(),\n}}];\n"
      },
      "name": "Normalize lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Never call a malformed number, a do-not-call number, or the same number\n// twice inside the window. Workflow static data is n8n's built-in per-workflow\n// store: it survives restarts and needs no database.\nconst lead = $input.first().json;\nconst store = $getWorkflowStaticData('global');\nstore.recent = store.recent || {};\nstore.dnc    = store.dnc    || [];\nconst now = Date.now(), WINDOW = 6 * 60 * 60 * 1000;\nfor (const k of Object.keys(store.recent)) if (now - store.recent[k] > WINDOW) delete store.recent[k];\n\nlet reason = null;\nif (!/^\\+1\\d{10}$/.test(lead.phone))     reason = 'invalid_number';\nelse if (store.dnc.includes(lead.phone))  reason = 'do_not_call';\nelse if (store.recent[lead.phone])        reason = 'duplicate_within_6h';\nif (!reason) store.recent[lead.phone] = now;\nreturn [{ json: { ...lead, ok: !reason, skipReason: reason } }];\n"
      },
      "name": "Guards: valid number, DNC, dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Passes guards?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        200
      ]
    },
    {
