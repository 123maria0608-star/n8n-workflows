{
  "name": "01 Speed-to-lead: webhook \u2192 AI call \u2192 CRM tag",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "New lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "secret",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.LEAD_WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Verify shared secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: 'bad secret' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "name": "Reject 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Two callers, one path: a CRM workflow webhook (GoHighLevel shape) and a\n// plain web form. Both end up as the same lead object.\nconst b = $input.first().json.body || {};\nconst c = b.customData || b.custom_data || {};\nconst first = b.first_name || b.firstName || b.name?.split(' ')[0] || '';\nconst last  = b.last_name  || b.lastName  || (b.name ? b.name.split(' ').slice(1).join(' ') : '');\nconst raw   = String(b.phone || c.phone || '').replace(/[^\\d+]/g, '');\nconst phone = raw.startsWith('+') ? raw : (raw.length === 10 ? '+1' + raw : raw.length === 11 && raw.startsWith('1') ? '+' + raw : '');\nreturn [{ json: {\n  contactId: b.contact_id || b.id || null,\n  name: `${first} ${last}`.trim() || 'there',\n  phone,\n  service: b.service || c.service || '',\n  vehicle: b.vehicle || c.vehicle || '',\n  source:  b.source  || c.source  || (b.customData ? 'ghl' : 'web-form'),\n  receivedAt: new Date().toISOString(),\n}}];\n"
      },
      "name": "Normalize lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Never call a number twice in the same window, never call a DNC number,\n// never call a malformed number. Static data is n8n's built-in per-workflow\n// store; it survives restarts and needs no database.\nconst lead = $input.first().json;\nconst store = $getWorkflowStaticData('global');\nstore.recent = store.recent || {};\nstore.dnc    = store.dnc    || [];\nconst now = Date.now(), WINDOW = 6 * 60 * 60 * 1000;\nfor (const k of Object.keys(store.recent)) if (now - store.recent[k] > WINDOW) delete store.recent[k];\n\nlet reason = null;\nif (!/^\\+1\\d{10}$/.test(lead.phone))        reason = 'invalid_number';\nelse if (store.dnc.includes(lead.phone))     reason = 'do_not_call';\nelse if (store.recent[lead.phone])           reason = 'duplicate_within_6h';\nif (!reason) store.recent[lead.phone] = now;\nreturn [{ json: { ...lead, ok: !reason, skipReason: reason } }];\n"
      },
      "name": "Guards: valid number, DNC, dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Passes guards?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vapi.ai/call",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  assistantId: $env.VAPI_ASSISTANT_ID,\n  phoneNumberId: $env.VAPI_PHONE_NUMBER_ID,\n  customer: { number: $json.phone, name: $json.name },\n  assistantOverrides: { variableValues: { name: $json.name, service: $json.service, vehicle: $json.vehicle } },\n  metadata: { contactId: $json.contactId, source: $json.source }\n}) }}",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "name": "Place AI outbound call (Vapi)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Vapi API key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $('Normalize lead').item.json.contactId }}/tags",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tags: ['ai-called','ai-attempt-1'] }) }}",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1500
          }
        }
      },
      "name": "Tag contact: ai-attempt-1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "GoHighLevel API token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, called: $('Normalize lead').item.json.phone } }}",
        "options": {}
      },
      "name": "Respond 200 (called)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1540,
        100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, skipped: $json.skipReason } }}",
        "options": {}
      },
      "name": "Respond 200 (skipped)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        340
      ]
    }
  ],
