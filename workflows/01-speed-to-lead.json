            "waitBetweenTries": 1500
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  assistantId: $('Config').item.json.vapiAssistantId,\n  phoneNumberId: $('Config').item.json.vapiPhoneNumberId,\n  customer: { number: $json.phone, name: $json.name },\n  assistantOverrides: { variableValues: { name: $json.name, service: $json.service, vehicle: $json.vehicle } },\n  metadata: { contactId: $json.contactId, source: $json.source }\n}) }}"
      },
