  "nodes": [
    {
      "parameters": {
        "content": "## End-of-call write-back\nVapi POSTs a report when a call ends. Turn its structured data into CRM tags the shop's own nurture automation branches on, plus a note a human can read in ten seconds.\n\nThe owner email is the backstop: it fires even when the CRM API fails (those two nodes are set to continue on error).",
        "width": 560,
        "height": 170
      },
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
