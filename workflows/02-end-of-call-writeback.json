      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "secret",
              "leftValue": "={{ $json.headers['x-vapi-secret'] }}",
              "rightValue": "={{ $('Config').item.json.vapiWebhookSecret }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "type",
              "leftValue": "={{ $json.body.message.type }}",
              "rightValue": "end-of-call-report",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
